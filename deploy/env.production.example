# Key names for the production .env on the server. Copy, then fill in the empty values BY HAND.
# Never commit the filled-in file. Keys marked SECRET exist only on the server.

# --- image (read by compose, not by Laravel)
IMAGE_TAG=

# --- app
APP_NAME=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pixelforge.mekteknoloji.com
# SECRET: `docker compose run --rm web php artisan key:generate --show` prints one; paste it here.
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# --- logs go to the container's stderr (docker compose logs)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- database: the compose service named "postgres". The DB_* and POSTGRES_* values must match.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
# SECRET
DB_PASSWORD=
POSTGRES_DB=
POSTGRES_USER=
# SECRET
POSTGRES_PASSWORD=

# --- queue, cache and sessions live in the database
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- Pixelforge. The key of THIS deployment only: it is used by the deployed app and nothing else.
# SECRET
PIXELFORGE_API_KEY=
# SECRET (the signing secret of the deployed API key)
PIXELFORGE_WEBHOOK_SECRET=
